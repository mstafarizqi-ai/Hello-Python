# Keep credentials local; never commit your real API token.
REPLICATE_API_TOKEN=r8_your_token_here

# Select a Replicate video model, using the owner/model format.
REPLICATE_MODEL=your-account/your-video-model

# Model-specific input mapping (see the model's Replicate page for accepted fields).
# Supported placeholders: {{prompt}}, {{aspect_ratio}}, {{duration}}
# Example only: customize these keys to match the selected model's schema.
REPLICATE_INPUT_TEMPLATE_JSON={"prompt":"{{prompt}}","aspect_ratio":"{{aspect_ratio}}","duration":{{duration}}}
